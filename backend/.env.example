# ================================================================
# EarnX Environment Configuration Template
# Copy this file to .env and customize values for your environment.
# NEVER commit real secrets or production credentials to Git!
# ================================================================

# Application Environment (development / staging / production)
APP_ENV=development
APP_NAME=EarnX
APP_DEBUG=true
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000

# Base URLs (Used for WebApp and CORS)
WEBAPP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration
# In development, leave empty to automatically fallback to SQLite: sqlite:///./earnx.db
# For PostgreSQL (e.g. Supabase / Render):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Note: Special characters in password (#, @, etc.) will be automatically URL-encoded by the backend.
DATABASE_URL=

# Telegram Bot & Mini App Configuration
# Obtain BOT_TOKEN and BOT_USERNAME from @BotFather on Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BOT_USERNAME=EarnXBot

# Monetag Ad Network Integration
# Obtain Zone ID and API keys from Monetag Publisher Dashboard
MONETAG_ZONE_ID=YOUR_MONETAG_ZONE_ID
MONETAG_API_KEY=YOUR_MONETAG_API_KEY
MONETAG_POSTBACK_SECRET=YOUR_MONETAG_POSTBACK_SECRET

# Security & JWT Tokens
# Generate with: openssl rand -hex 32
SECRET_KEY=earnx_development_secret_key_change_in_production_9f8a7b6c5d4e3f2a1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (Created automatically on startup if not present)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@earnx.app
ADMIN_PASSWORD=AdminSecurePassword123!

# Reward Economics Configuration
COINS_PER_RUPEE=100.0
MIN_WITHDRAWAL_RUPEES=50.0
REFERRAL_BONUS_COINS=50.0
REFERRAL_QUALIFYING_ACTIONS=3
DAILY_MAX_REWARD_COINS=1000.0
DAILY_MAX_WITHDRAWAL_RUPEES=500.0

# Anti-Fraud Thresholds
MAX_ADS_PER_HOUR=30
MIN_SECONDS_BETWEEN_ADS=60
MAX_FAILED_ATTEMPTS=5
